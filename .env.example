# ============================================================================
# Enterprise Agentic RAG - Environment Variables Template
# ============================================================================
# INSTRUCTIONS:
# 1. Copy this file to .env
# 2. Fill in your actual values (DO NOT commit .env to git)
# 3. All values are required unless marked as optional
# ============================================================================

# ============================================================================
# Phase 1: Identity & Security
# ============================================================================

# Azure Active Directory Tenant ID
AZURE_TENANT_ID=your-tenant-id-here

# SharePoint App Registration (Entra ID)
# Requires: Files.Read.All, Sites.Read.All (Application permissions with admin consent)
SHAREPOINT_APP_ID=your-app-id-here
SHAREPOINT_APP_SECRET=your-app-secret-here

# ============================================================================
# Phase 2: SharePoint Configuration
# ============================================================================

# SharePoint Site URL (the site containing documents to index)
# Format: https://tenant.sharepoint.com/sites/SiteName
SHAREPOINT_SITE_URL=https://your-tenant.sharepoint.com/sites/YourSite

# ============================================================================
# Phase 2: Azure AI Search
# ============================================================================

# Azure AI Search service endpoint
# Format: https://your-search-service.search.windows.net
SEARCH_ENDPOINT=https://your-search-service.search.windows.net

# Azure AI Search admin key (from Keys section in Azure Portal)
SEARCH_ADMIN_KEY=your-search-admin-key-here

# ============================================================================
# Phase 2: Azure AI Foundry Project
# ============================================================================

# Azure AI Foundry project endpoint
# Format: https://your-foundry.services.ai.azure.com/api/projects/project-name
PROJECT_ENDPOINT=https://your-foundry.services.ai.azure.com/api/projects/your-project

# Azure AI Foundry project API key
PROJECT_API_KEY=your-project-api-key-here

# Azure AI Foundry project connection string (same as endpoint)
PROJECT_STRING=https://your-foundry.services.ai.azure.com/api/projects/your-project

# Azure AI Search connection name in Foundry project
# (Found in AI Foundry > Management Center > Connected Resources)
SEARCH_CONN_NAME=your-search-connection-name

# ============================================================================
# Phase 5: Embedding Model Configuration
# ============================================================================

# Azure OpenAI endpoint
# Format: https://your-openai-resource.openai.azure.com/
AZURE_OPENAI_ENDPOINT=https://your-openai-resource.openai.azure.com/

# Azure OpenAI embedding model deployment name
# Common values: text-embedding-3-large, text-embedding-3-small, text-embedding-ada-002
EMBEDDING_DEPLOYMENT_NAME=text-embedding-3-large

# ============================================================================
# SECURITY NOTES
# ============================================================================
# - NEVER commit the .env file to git
# - Rotate secrets regularly (especially after team member changes)
# - Use Azure Key Vault in production environments
# - Limit SharePoint app permissions to minimum required
# - Use separate credentials for dev/staging/production
# ============================================================================
VISION_DEPLOYMENT_NAME=gpt-4.1